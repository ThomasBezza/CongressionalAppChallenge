#!/bin/sh
set -eu
cd "$(dirname "$0")"
if ! command -v node >/dev/null 2>&1; then
  echo 'Node.js 24 is needed. Install it from https://nodejs.org/ and run ./dev again.' >&2
  exit 1
fi
if [ "${1:-}" = '--lan' ] || [ "${1:-}" = '--https-preview' ] || [ "${1:-}" = '--hosted' ]; then exec node server.mjs "$@"; fi
if [ "$#" -gt 0 ]; then exec node "$@"; fi
exec node server.mjs
